{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "section_id": {
          "minLength": 1,
          "title": "Section Id",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "section_id",
        "quote",
        "url"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "scanned_files": {
          "items": {
            "type": "string"
          },
          "title": "Scanned Files",
          "type": "array"
        },
        "skipped_files": {
          "items": {
            "$ref": "#/$defs/SkippedFile"
          },
          "title": "Skipped Files",
          "type": "array"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        },
        "supported_languages": {
          "items": {
            "type": "string"
          },
          "title": "Supported Languages",
          "type": "array"
        },
        "corpus_scope": {
          "items": {
            "type": "string"
          },
          "title": "Corpus Scope",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "title": "Coverage",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "path",
        "start_line",
        "end_line",
        "quote"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "kind": {
          "enum": [
            "potential_issue",
            "context_question"
          ],
          "title": "Kind",
          "type": "string"
        },
        "priority": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Priority",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        },
        "suggested_next_action": {
          "minLength": 1,
          "title": "Suggested Next Action",
          "type": "string"
        },
        "context_question": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Question"
        }
      },
      "required": [
        "id",
        "title",
        "explanation",
        "kind",
        "priority",
        "evidence",
        "citations",
        "suggested_next_action"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Metadata": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "anyOf": [
            {
              "enum": [
                "ollama",
                "gemini"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "prompt_version": {
          "default": "poc-5",
          "title": "Prompt Version",
          "type": "string"
        },
        "corpus_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corpus Version"
        },
        "corpus_checksum": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corpus Checksum"
        },
        "input_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Fingerprint"
        },
        "elapsed_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Elapsed Ms",
          "type": "integer"
        }
      },
      "title": "Metadata",
      "type": "object"
    },
    "ScanError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ScanError",
      "type": "object"
    },
    "SkippedFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "path",
        "reason"
      ],
      "title": "SkippedFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "maxItems": 4,
      "title": "Findings",
      "type": "array"
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/ScanError"
      },
      "title": "Errors",
      "type": "array"
    },
    "coverage": {
      "$ref": "#/$defs/Coverage"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    }
  },
  "required": [
    "status"
  ],
  "title": "ScanResult",
  "type": "object"
}
