# Runtime defaults. Copy to .env. Never commit credentials.
# After you save dashboard Settings, local workbench values take precedence over these defaults.
AIACT_PORT=8000
AIACT_API_PORT=8001
AIACT_API_TARGET=http://127.0.0.1:8001
AIACT_PROVIDER=gemini
AIACT_MODEL=gemini-3.1-flash-lite
AIACT_DEMO_MODE=true
AIACT_DEMO_TENANT_NAME="AI Act Demo"
AIACT_DEMO_USER_EMAIL=demo@example.test
GEMINI_API_KEY=
# Leave false. The dashboard asks per request; CLI can explicitly opt in.
AIACT_CLOUD_CONSENT=false
# Native defaults are relative; Compose defaults use its persistent /data volume.
# Override DATABASE_URL only when deliberately selecting another database.
# DATABASE_URL=sqlite:///.aiact-workbench/aiact.db
# AIACT_DATA_DIR=.aiact-workbench
# Optional PostgreSQL Compose profile. The local profile uses Docker-network-only
# trust auth and publishes no database port. Setting DATABASE_URL does not copy
# or migrate data from the SQLite volume.
POSTGRES_DB=aiact
POSTGRES_USER=aiact
# DATABASE_URL=postgresql+psycopg://aiact@postgres:5432/aiact
VECTOR_BACKEND=qdrant-local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_REVISION=file-sha256-pinned-at-build
LANGFUSE_ENABLED=false
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PROJECT_ID=
